generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String?
  role                String    @default("USER")
  openaiKeyEncrypted  String?
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  watchlist       Watchlist[]
  savedSearches   SavedSearch[]
  alerts          Alert[]
  outreachDrafts  OutreachDraft[]
  sessions        Session[]
  accounts        Account[]
  jobApplications JobApplication[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// COMPANY & FUNDING
// ============================================

model Company {
  id          String    @id @default(cuid())
  name        String
  domain      String?
  description String?
  country     String?
  state       String?
  city        String?
  linkedinUrl String?
  careersUrl  String?
  headcount   Int?
  foundedYear Int?
  logoUrl     String?
  tags        String?   // JSON string for SQLite

  // YC-specific fields
  ycBatch      String?   // e.g., "W24", "S23"
  ycUrl        String?   // YC company page
  ycId         Int?      // YC company ID
  dataSource   String    @default("INGESTION")  // INGESTION, YC, MANUAL
  lastSyncedAt DateTime?
  oneLiner     String?   // Short company description
  isHiring     Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  fundingEvents   FundingEvent[]
  jobPostings     JobPosting[]
  people          Person[]
  watchlistedBy   Watchlist[]
  outreachDrafts  OutreachDraft[]
  jobApplications JobApplication[]

  @@index([name])
  @@index([createdAt])
  @@index([country])
  @@index([dataSource])
  @@index([ycBatch])
  @@index([isHiring])
}

model FundingEvent {
  id           String    @id @default(cuid())
  companyId    String
  roundType    String    // Enum as string for SQLite
  amountCents  BigInt?
  announcedAt  DateTime
  investors    String?   // JSON string for SQLite
  leadInvestor String?
  summary      String?
  sourceUrl    String?
  sourceName   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([roundType])
  @@index([announcedAt])
  @@index([amountCents])
}

model JobPosting {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  location    String?
  remote      Boolean   @default(false)
  department  String?
  description String?
  postedAt    DateTime  @default(now())
  url         String?
  externalId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, externalId])
  @@index([companyId])
  @@index([postedAt])
  @@index([department])
}

model Person {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  role        String?
  title       String?           // More specific job title
  department  String?           // engineering, hr, sales, etc.
  seniority   String?           // entry, senior, manager, director, vp, c-level
  linkedinUrl String?
  email       String?
  emailStatus String    @default("UNKNOWN")  // VERIFIED, UNVERIFIED, INVALID, UNKNOWN
  phone       String?
  source      String    @default("MANUAL")   // MANUAL, APOLLO, HUNTER, LINKEDIN
  sourceUrl   String?
  confidence  Float?            // 0-1 confidence score from enrichment
  enrichedAt  DateTime?
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([role])
  @@index([seniority])
  @@index([department])
}

// ============================================
// USER FEATURES
// ============================================

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   String   // JSON string for SQLite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  name        String
  filters     String    // JSON string for SQLite
  email       String
  enabled     Boolean   @default(true)
  lastSentAt  DateTime?
  matchCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@index([lastSentAt])
}

model OutreachDraft {
  id          String   @id @default(cuid())
  userId      String
  companyId   String
  type        String   // Enum as string for SQLite
  subject     String?
  body        String
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model JobApplication {
  id          String    @id @default(cuid())
  userId      String
  companyId   String
  position    String
  status      String    @default("APPLIED")  // APPLIED, PHONE_SCREEN, TECHNICAL, ONSITE, OFFER, REJECTED, WITHDRAWN
  appliedAt   DateTime  @default(now())
  url         String?   // Link to job posting or application
  source      String?   // CAREERS_PAGE, LINKEDIN, REFERRAL, COLD_OUTREACH
  notes       String?
  nextStepAt  DateTime?
  nextStep    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, position])
  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([appliedAt])
}

// ============================================
// API CREDITS
// ============================================

model ApiCredits {
  id           String   @id @default(cuid())
  provider     String   @unique  // APOLLO, HUNTER, NEWSAPI, CLEARBIT
  creditsUsed  Int      @default(0)
  creditsLimit Int
  resetDate    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// INGESTION
// ============================================

model IngestionRun {
  id             String    @id @default(cuid())
  source         String?
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  itemsProcessed Int       @default(0)
  errorCount     Int       @default(0)
  createdAt      DateTime  @default(now())

  logs IngestionLog[]

  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model IngestionLog {
  id        String   @id @default(cuid())
  runId     String
  level     String   // Enum as string for SQLite
  message   String
  details   String?  // JSON string for SQLite
  timestamp DateTime @default(now())

  run IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([level])
  @@index([timestamp])
}
