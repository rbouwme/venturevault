generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String?
  role               String    @default("USER")
  openaiKeyEncrypted String?
  emailVerified      DateTime?
  image              String?
  linkedinUrl        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  watchlist          Watchlist[]
  savedSearches      SavedSearch[]
  alerts             Alert[]
  outreachDrafts     OutreachDraft[]
  sessions           Session[]
  accounts           Account[]
  jobApplications    JobApplication[]
  folders            Folder[]
  favoriteIndustries FavoriteIndustry[]
  prospects          Prospect[]
  prospectNotes      ProspectNote[]
  recommendations    Recommendation[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// COMPANY & FUNDING
// ============================================

model Company {
  id          String  @id @default(cuid())
  name        String
  domain      String?
  description String?
  country     String?
  state       String?
  city        String?
  linkedinUrl String?
  careersUrl  String?
  headcount   Int?
  foundedYear Int?
  logoUrl     String?
  tags        String? // JSON string for SQLite

  // YC-specific fields
  ycBatch      String? // e.g., "W24", "S23"
  ycUrl        String? // YC company page
  ycId         Int? // YC company ID
  dataSource   String    @default("INGESTION") // INGESTION, YC, MANUAL
  lastSyncedAt DateTime?
  oneLiner     String? // Short company description
  isHiring     Boolean   @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  fundingEvents   FundingEvent[]
  jobPostings     JobPosting[]
  people          Person[]
  watchlistedBy   Watchlist[]
  outreachDrafts  OutreachDraft[]
  jobApplications JobApplication[]
  prospects       Prospect[]
  prospectSignals ProspectSignal[]
  recommendations Recommendation[]

  @@index([name])
  @@index([createdAt])
  @@index([country])
  @@index([dataSource])
  @@index([ycBatch])
  @@index([isHiring])
}

model FundingEvent {
  id           String   @id @default(cuid())
  companyId    String
  roundType    String // Enum as string for SQLite
  amountCents  BigInt?
  announcedAt  DateTime
  investors    String? // JSON string for SQLite
  leadInvestor String?
  summary      String?
  sourceUrl    String?
  sourceName   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([roundType])
  @@index([announcedAt])
  @@index([amountCents])
}

model JobPosting {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  location    String?
  remote      Boolean   @default(false)
  department  String?
  description String?
  postedAt    DateTime  @default(now())
  url         String?
  externalId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, externalId])
  @@index([companyId])
  @@index([postedAt])
  @@index([department])
}

model Person {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  role        String?
  title       String? // More specific job title
  department  String? // engineering, hr, sales, etc.
  seniority   String? // entry, senior, manager, director, vp, c-level
  linkedinUrl String?
  email       String?
  emailStatus String    @default("UNKNOWN") // VERIFIED, UNVERIFIED, INVALID, UNKNOWN
  phone       String?
  source      String    @default("MANUAL") // MANUAL, APOLLO, HUNTER, LINKEDIN
  sourceUrl   String?
  confidence  Float? // 0-1 confidence score from enrichment
  enrichedAt  DateTime?
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([role])
  @@index([seniority])
  @@index([department])
}

// ============================================
// USER FEATURES
// ============================================

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   String // JSON string for SQLite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id         String    @id @default(cuid())
  userId     String
  name       String
  filters    String // JSON string for SQLite
  email      String
  enabled    Boolean   @default(true)
  lastSentAt DateTime?
  matchCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
  @@index([lastSentAt])
}

model OutreachDraft {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  type      String // Enum as string for SQLite
  subject   String?
  body      String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model JobApplication {
  id         String    @id @default(cuid())
  userId     String
  companyId  String
  position   String
  status     String    @default("APPLIED") // APPLIED, PHONE_SCREEN, TECHNICAL, ONSITE, OFFER, REJECTED, WITHDRAWN
  appliedAt  DateTime  @default(now())
  url        String? // Link to job posting or application
  source     String? // CAREERS_PAGE, LINKEDIN, REFERRAL, COLD_OUTREACH
  notes      String?
  nextStepAt DateTime?
  nextStep   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, position])
  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([appliedAt])
}

// ============================================
// FAVORITES & FOLDERS
// ============================================

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String? // Hex color for UI
  icon      String? // Icon name
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  industries FavoriteIndustry[]

  @@unique([userId, name])
  @@index([userId])
  @@index([order])
}

model FavoriteIndustry {
  id        String   @id @default(cuid())
  userId    String
  industry  String // Industry name (e.g., "Fintech", "Healthcare")
  folderId  String? // Optional folder assignment
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, industry])
  @@index([userId])
  @@index([folderId])
  @@index([order])
}

// ============================================
// API CREDITS
// ============================================

model ApiCredits {
  id           String   @id @default(cuid())
  provider     String   @unique // APOLLO, HUNTER, NEWSAPI, CLEARBIT
  creditsUsed  Int      @default(0)
  creditsLimit Int
  resetDate    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// INGESTION
// ============================================

model IngestionRun {
  id             String    @id @default(cuid())
  source         String?
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  itemsProcessed Int       @default(0)
  errorCount     Int       @default(0)
  createdAt      DateTime  @default(now())

  logs IngestionLog[]

  @@index([source])
  @@index([status])
  @@index([startedAt])
}

model IngestionLog {
  id        String   @id @default(cuid())
  runId     String
  level     String // Enum as string for SQLite
  message   String
  details   String? // JSON string for SQLite
  timestamp DateTime @default(now())

  run IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([level])
  @@index([timestamp])
}

// ============================================
// PROSPECTS
// ============================================

model Prospect {
  id        String @id @default(cuid())
  userId    String
  companyId String

  // CRM Fields
  status          String    @default("NEW") // NEW, CONTACTED, RESPONDED, QUALIFIED, DISQUALIFIED, CONVERTED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  nextAction      String?
  nextActionDate  DateTime?
  lastContactedAt DateTime?
  source          String    @default("AUTO_SIGNAL") // AUTO_SIGNAL, MANUAL, REFERRAL

  // Signal Tracking
  confidenceScore    Float     @default(0.0) // 0.0 - 1.0
  timelinePrediction String? // "1_3_MONTHS", "3_6_MONTHS", "6_12_MONTHS"
  signalCount        Int       @default(0)
  lastSignalAt       DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  convertedAt DateTime?
  archivedAt  DateTime?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes   ProspectNote[]
  signals ProspectSignal[]

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([confidenceScore])
  @@index([nextActionDate])
  @@index([createdAt])
}

model ProspectSignal {
  id         String @id @default(cuid())
  prospectId String
  companyId  String

  type        String // HIRING_SPIKE, NEWS_MENTION, HEADCOUNT_GROWTH, JOB_VELOCITY, FUNDING_PATTERN
  strength    Float // 0.0 - 1.0
  metadata    String? // JSON with signal details
  description String?

  detectedAt DateTime  @default(now())
  expiresAt  DateTime?

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([companyId])
  @@index([type])
  @@index([detectedAt])
  @@index([strength])
}

model ProspectNote {
  id         String @id @default(cuid())
  prospectId String
  userId     String

  content      String
  type         String    @default("NOTE") // NOTE, REMINDER, CALL_LOG, EMAIL_LOG
  reminderDate DateTime?
  completed    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([userId])
  @@index([type])
  @@index([reminderDate])
  @@index([completed])
}

model Recommendation {
  id        String @id @default(cuid())
  userId    String
  companyId String

  // Scoring & Matching
  score        Float   @default(0.0) // 0.0 - 1.0 similarity score
  matchReason  String // WATCHLIST_SIMILAR, POPULAR_TRENDING
  matchFactors String? // JSON: { tagMatch: 0.8, locationMatch: 1.0, ... }

  // Metadata
  createdAt DateTime  @default(now())
  expiresAt DateTime // 24-hour TTL
  viewedAt  DateTime?
  clickedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@index([score])
  @@index([expiresAt])
  @@index([matchReason])
}
